--- IBM/mmcesExtendedIpMgmt.azure
+++ review/mmcesExtendedIpMgmt.azure
@@ -14,21 +14,202 @@
 # cleanup ip by: ip addr del <ip> dev <interface>
 # mmcesfunc returns a no-op ": ip addr del <ip> dev <interface>".
 function cleanupIP {
-  typeset cmd="$*"
-  cmd="${cmd#*: }" # Remove the no-op before processing
   typeset ipAddr=$5
   typeset interface=$7
-  print -- "[Azure] The past alias ip $ipAddr already exists on interface $interface. Cleaning. "
-  ${cmd}
-  return $?
+  typeset addresses prefix
+  typeset -i result
+  logAzureCesEvent cleanup-start "$ipAddr"
+  lockAzureCesIP || return $?
+  addresses=$(ip -j -4 address show dev "$interface") || return $?
+  prefix=$(print -r -- "$addresses" | jq -er --arg ip "$ipAddr" '
+    [.[].addr_info[] | select(.local == $ip) | .prefixlen]
+    | if length == 1 then .[0] else error("CES guest address missing or ambiguous") end
+  ') || {
+    print -u2 -- "[Azure] Cannot determine existing CES prefix on $interface"
+    return 1
+  }
+  reconcileAzureCesIP /usr/sbin/ip a replace "$ipAddr/$prefix" dev "$interface"
+  result=$?
+  logAzureCesEvent "cleanup-complete-rc-$result" "$ipAddr"
+  return $result
 }
 
 # enable ip by: /sbin/ifconfig <interface> <ip> netmask <interfaceMask>
-function enableIP
+# Azure CES hook helpers; experimental two-node integration.
+# Context validation is shared by acquisition and removal.
+function logAzureCesEvent
+{
+  print -u2 -- "[AzureTiming] epoch=$(/usr/bin/date +%s.%N) pid=$$ event=$1 ip=$2"
+}
+
+function validateAzureCesContext
+{
+  typeset address=$1 nic=$2 group=$3 vm=$4
+  typeset peer peerNic cesNode
+  typeset -l groupLower="$group"
+
+  case "$address" in
+    @ADDRESSES@) ;;
+    *) print -u2 -- "[Azure] Refusing unexpected CES address: $address"; return 1 ;;
+  esac
+  [[ "$groupLower" == @RESOURCE_GROUP@ ]] || {
+    print -u2 -- "[Azure] Refusing unexpected resource group: $group"
+    return 1
+  }
+  case "$vm:$nic" in
+    @NODE1_VM@:@NODE1_NIC@)
+      peer=@NODE2_VM@; peerNic="@NODE2_NIC@"
+      cesNode=@NODE1_CES_NODE@
+      ;;
+    @NODE2_VM@:@NODE2_NIC@)
+      peer=@NODE1_VM@; peerNic="@NODE1_NIC@"
+      cesNode=@NODE2_CES_NODE@
+      ;;
+    *) print -u2 -- "[Azure] Refusing unexpected VM/NIC: $vm/$nic"; return 1 ;;
+  esac
+
+  print -r -- "$peer $peerNic $cesNode"
+}
+
+# Each public entry point holds this descriptor until the hook exits.
+function lockAzureCesIP
+{
+  logAzureCesEvent lock-wait ""
+  exec 9>/var/mmfs/etc/.azure-ces-ip.lock || return $?
+  /usr/bin/flock -x -w 20 9 9>&9 || {
+    print -u2 -- "[Azure] Timed out waiting for local hook lock"
+    return 1
+  }
+  logAzureCesEvent lock-acquired ""
+}
+
+function prepareAzureCesIP
+{
+  typeset address=$1 nic=$2 group=$3 vm=$4
+  typeset subscription="@SUBSCRIPTION@"
+  typeset peer peerNic cesNode subnet nics matches count owner config primary
+  typeset state context
+  context=$(validateAzureCesContext "$address" "$nic" "$group" "$vm") || return $?
+  read -r peer peerNic cesNode <<< "$context"
+  checkAzureCesAssignment "$address" "$cesNode" || return $?
+
+  subnet=$(/usr/bin/az network nic show --subscription "$subscription" \
+    -g "$group" -n "$nic" \
+    --query "ipConfigurations[?primary].subnet.id | [0]" -o tsv) || return $?
+  [[ -n "$subnet" ]] || {
+    print -u2 -- "[Azure] Cannot determine protocol subnet"
+    return 1
+  }
+  nics=$(/usr/bin/az network nic list --subscription "$subscription" \
+    -g "$group" -o json) || return $?
+  print -r -- "$nics" | jq -e --arg nic "$nic" \
+    --arg name "@IP_CONFIG_PREFIX@-${address//./-}" --arg legacy "${vm}-ces-${address//./-}" --arg ip "$address" '
+    [.[] | select(.name == $nic) | .ipConfigurations[]
+      | select((.name == $name or .name == $legacy) and .privateIPAddress != $ip)] | length == 0
+  ' >/dev/null || {
+    print -u2 -- "[Azure] Expected configuration name belongs to another address"
+    return 1
+  }
+  matches=$(print -r -- "$nics" | jq -ce --arg ip "$address" --arg subnet "$subnet" '
+    [.[] as $nic | $nic.ipConfigurations[]
+      | select(.privateIPAddress == $ip and
+          ((.subnet.id | ascii_downcase) == ($subnet | ascii_downcase)))
+      | {nic: $nic.name, config: .name, primary: .primary}]
+  ') || return $?
+  count=$(print -r -- "$matches" | jq -r 'length') || return $?
+  if [[ "$count" == 0 ]]
+  then
+    print -- yes
+    return 0
+  fi
+  [[ "$count" == 1 ]] || {
+    print -u2 -- "[Azure] Refusing ambiguous allocation for $address"
+    return 1
+  }
+  owner=$(print -r -- "$matches" | jq -r '.[0].nic') || return $?
+  config=$(print -r -- "$matches" | jq -r '.[0].config') || return $?
+  primary=$(print -r -- "$matches" | jq -r '.[0].primary') || return $?
+  [[ "$primary" == false ]] || {
+    print -u2 -- "[Azure] Refusing primary or unknown allocation for $address"
+    return 1
+  }
+  if [[ "$owner" == "$nic" ]]
+  then
+    [[ "$config" == "@IP_CONFIG_PREFIX@-${address//./-}" ||
+       "$config" == "${vm}-ces-${address//./-}" ]] || {
+      print -u2 -- "[Azure] Refusing unexpected local allocation: $owner/$config"
+      return 1
+    }
+    print -u2 -- "[Azure] $address already allocated to $nic; skip creation"
+    print -- no
+    return 0
+  fi
+  [[ "$owner" == "$peerNic" &&
+     ( "$config" == "@IP_CONFIG_PREFIX@-${address//./-}" ||
+       "$config" == "${peer}-ces-${address//./-}" ) ]] || {
+    print -u2 -- "[Azure] Refusing unexpected peer allocation: $owner/$config"
+    return 1
+  }
+
+  state=$(/usr/bin/az vm get-instance-view --subscription "$subscription" \
+    -g "$group" -n "$peer" \
+    --query "instanceView.statuses[?starts_with(code, 'PowerState/')].code | [0]" \
+    -o tsv) || return $?
+  [[ "$state" == PowerState/stopped || "$state" == PowerState/deallocated ]] || {
+    print -u2 -- "[Azure] Will not release $address: peer state is $state"
+    return 1
+  }
+  checkAzureCesAssignment "$address" "$cesNode" || return $?
+  print -u2 -- "[Azure] Releasing $address from stopped peer $peer"
+  logAzureCesEvent peer-delete-start "$address"
+  /usr/bin/az network nic ip-config delete --subscription "$subscription" \
+    -g "$group" --nic-name "$peerNic" -n "$config" -o none || return $?
+  logAzureCesEvent peer-delete-complete "$address"
+
+  nics=$(/usr/bin/az network nic list --subscription "$subscription" \
+    -g "$group" -o json) || return $?
+  print -r -- "$nics" | jq -e --arg ip "$address" --arg subnet "$subnet" '
+    [.[] | .ipConfigurations[]
+      | select(.privateIPAddress == $ip and
+          ((.subnet.id | ascii_downcase) == ($subnet | ascii_downcase)))]
+    | length == 0
+  ' >/dev/null || {
+    print -u2 -- "[Azure] Release of $address not confirmed; will not create"
+    return 1
+  }
+  checkAzureCesAssignment "$address" "$cesNode" || return $?
+  print -- yes
+}
+
+function checkAzureCesAssignment
+{
+  typeset pool mode=${3:-local}
+  pool=$(/usr/lpp/mmfs/bin/mmces address list -Y) || return $?
+  print -r -- "$pool" | awk -F: -v ip="$1" -v node="$2" -v mode="$mode" '
+    $1 == "mmces" && $2 == "addressList" && $3 != "HEADER" && $7 == ip {
+      count++
+      if ($8 == node) assigned++
+      if ($8 != "") owners++
+    }
+    END {
+      exit !(count == 1 && owners == 1 &&
+        ((mode == "local" && assigned == 1) ||
+         (mode == "remote" && assigned == 0)))
+    }
+  ' || {
+    print -u2 -- "[Azure] CES assignment does not confirm $mode ownership of $1 for $2"
+    return 1
+  }
+}
+
