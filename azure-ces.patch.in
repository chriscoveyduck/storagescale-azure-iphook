+  return 0
+}
+
+function enableIP
+{
+  typeset -i result
+  logAzureCesEvent enable-start "$4"
+  lockAzureCesIP || return $?
+  reconcileAzureCesIP "$@"
+  result=$?
+  logAzureCesEvent "enable-complete-rc-$result" "$4"
+  return $result
 }
 
